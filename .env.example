# ---------------------------------------------------------------------------
# SecureQuiz environment
#
# Copy to `.env` and fill in. Never commit the real `.env`.
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
# The bundled docker-compose.yml matches these credentials.
DATABASE_URL="postgresql://securequiz:securequiz@localhost:5432/securequiz?schema=public"

# Signs the short-lived access token (JWT). MUST be at least 32 characters.
# The app refuses to start in production without it.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="replace-me-with-at-least-32-random-characters"

# Server-side pepper mixed into OTP hashes and into the IP/device digests, so
# those values cannot be reversed or correlated from a database dump alone.
# Rotating this invalidates outstanding OTPs and existing device fingerprints.
HASH_PEPPER="replace-me-with-a-different-32-plus-character-secret"

# Development OTP mode: shows the one-time code on the login screen instead of
# sending it, so anyone can sign in as anyone. OFF unless set to exactly "true",
# and ignored when NODE_ENV=production unless the escape hatch below is also set.
# Uncomment for local development only.
# OTP_DEV_MODE="true"
#
# INSECURE escape hatch: allows OTP_DEV_MODE in a production build. Only for
# local `npm start` smoke tests or a staging box with no real students; the
# server logs a warning at startup of each process. Never set it in production.
# OTP_DEV_MODE_ALLOW_IN_PRODUCTION="i-understand-this-is-insecure"

# Where uploaded images are written — question diagrams and photographed answer
# sheets. Kept outside `public/` on purpose: every read goes through an
# authorising route, so no file is reachable by guessing a URL.
# Back this directory up with the database; the two are useless apart.
UPLOAD_DIR="./var/uploads"

# AI question generation (Gemini File Search + a Flash model). Free key from
# https://aistudio.google.com/apikey. Leave empty to hide the feature. On the
# free tier Google may use uploaded material to improve its products.
GEMINI_API_KEY=""
# Optional: pin a model. Defaults to the latest Flash model.
# GEMINI_MODEL="gemini-flash-latest"
# Used when that model is overloaded (Google often answers 503 on the free tier).
# GEMINI_FALLBACK_MODEL="gemini-flash-lite-latest"
# Tests only: AI_PROVIDER="fake" answers without calling Google.

# Resend (https://resend.com) sends the real OTP emails. Outside production,
# a missing key makes deliverOtp() log the code to the server console. In
# production (dev mode off), a missing key, a missing OTP_FROM_EMAIL, or a
# resend.dev sender makes every code request fail with a 503 and a server error.
# Until a sending domain is verified in the Resend dashboard, the default
# onboarding@resend.dev sender can only deliver to the email address you
# signed up to Resend with — not to arbitrary student addresses. Verify a
# domain and point OTP_FROM_EMAIL at it before this needs to reach real users.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
OTP_FROM_EMAIL="SecureQuiz <onboarding@resend.dev>"

# ---------------------------------------------------------------------------
# Production notes
# ---------------------------------------------------------------------------
# * Terminate TLS in front of the app. Cookies are marked Secure automatically
#   when NODE_ENV=production, so plain HTTP will not hold a session.
# * Verify a sending domain in Resend and update OTP_FROM_EMAIL — the default
#   onboarding@resend.dev sender only reaches your own Resend account email.
# * Rate limiting is in-process. For more than one instance, back
#   `src/lib/rate-limit.ts` with Redis.
